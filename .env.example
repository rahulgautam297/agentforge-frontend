# Base URL for the control-plane API (agent registry, YAML validation, deploy).
# Consumed client-side (NEXT_PUBLIC_*) because the browser calls it directly.
NEXT_PUBLIC_CONTROL_PLANE_URL=http://localhost:8000/api/v1

# Base URL for the execution-platform API (trigger/read executions and traces).
NEXT_PUBLIC_EXECUTION_PLANE_URL=http://localhost:8001/api/v1

# Phase 1 dev-only auth shim: a static bearer token sent with every request.
NEXT_PUBLIC_DEV_BEARER_TOKEN=dev-local-token
